{
  "name": "wps7",
  "version": "0.1.5",
  "private": true,
  "license": "MIT",
  "author": "tonyieong",
  "description": "Portable Windows web tmux-continuum style terminal workspace.",
  "keywords": [
    "terminal",
    "powershell",
    "windows",
    "conpty",
    "xterm",
    "web-terminal",
    "workspace",
    "tmux-continuum"
  ],
  "homepage": "https://github.com/tonyieong/wps7#readme",
  "bugs": "https://github.com/tonyieong/wps7/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyieong/wps7.git"
  },
  "main": "src/main.js",
  "bin": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "start": "node src/main.js",
    "test": "node --test",
    "lint": "eslint .",
    "verify:mobile-scroll": "node scripts/verify-mobile-scroll.js",
    "licenses:sync": "node scripts\\sync-third-party-license-sources.js",
    "licenses:generate": "node scripts\\generate-third-party-notices.js",
    "package:win": "pkg . --targets node22-win-x64 --output dist/wps7.exe && node scripts\\set-windows-subsystem.js dist\\wps7.exe && powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item 'dist\\scripts\\scripts','dist\\assets\\assets','dist\\plugin-panes\\plugin-panes' -Recurse -Force -ErrorAction SilentlyContinue; New-Item -ItemType Directory dist\\scripts,dist\\assets,dist\\plugin-panes -Force | Out-Null; Copy-Item scripts\\* dist\\scripts -Recurse -Force; Copy-Item assets\\* dist\\assets -Recurse -Force; Copy-Item plugin-panes\\* dist\\plugin-panes -Recurse -Force\"",
    "startup:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\install-wps7-startup.ps1",
    "startup:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\repair-wps7-paths.ps1",
    "startup:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\uninstall-wps7-startup.ps1"
  },
  "pkg": {
    "assets": [
      "assets/**/*",
      "scripts/**/*",
      "public/**/*",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/build/Release/*.node",
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/build/Release/conpty/**/*",
      "node_modules/systray2/traybin/**/*"
    ]
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@iarna/toml": "^2.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "busboy": "^1.6.0",
    "express": "^5.2.1",
    "selfsigned": "^4.0.1",
    "systray2": "^2.1.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@yao-pkg/pkg": "^6.22.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1"
  }
}
